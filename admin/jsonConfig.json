{
	"i18n": true,
	"type": "tabs",
	"items": {
		"_options": {
			"type": "panel",
			"label": "Options",
			"items": {
				"username": {
					"type": "text",
					"xs": 12,
					"sm": 6,
					"md": 3,
					"lg": 3,
					"label": "Username",
					"help": "Your username for the Ochsner Roomterminal"
				},
				"password": {
					"type": "password",
					"xs": 12,
					"sm": 6,
					"md": 3,
					"lg": 3,
					"label": "Password",
					"help": "Your password for the Ochsner Roomterminal",
					"visible": true
				},
				"serverIP": {
					"type": "text",
					"xs": 12,
					"sm": 6,
					"md": 3,
					"lg": 3,
					"label": "Server",
					"help": "Your IP or hostname of the Ochsner Roomterminal",
					"validator": "!!data.serverIP",
					"validatorNoSaveOnError": true
				},
				"pollInterval": {
					"type": "number",
					"min": 1,
					"max": 65535,
					"xs": 12,
					"sm": 3,
					"md": 2,
					"lg": 2,
					"label": "Interval",
					"help": "Interval in sec between group read requests"
				}
			}
		},
		"OIDs": {
			"type": "panel",
			"label": "OIDs",
			"items": {
				"OIDs": {
					"newLine": true,
					"type": "table",
					"label": "OIDs",
					"noDelete": false,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"items": [
						{
							"type": "checkbox",
							"default": true,
							"width": "5%",
							"title": "enabled",
							"attr": "enabled"
						},
						{
							"type": "text",
							"attr": "oid",
							"width": "15%",
							"title": "OID",
							"filter": false,
							"sort": true,
							"default": ""
						},
						{
							"type": "text",
							"attr": "name",
							"default": "",
							"width": "30%",
							"title": "Name",
							"filter": false,
							"sort": true
						},
						{
							"type": "checkbox",
							"attr": "isStatus",
							"default": false,
							"width": "5%",
							"title": "is Status",
							"filter": false,
							"sort": false
						},
						{
							"type": "number",
							"attr": "group",
							"min": 0,
							"max": 15,
							"default": 0,
							"width": "5%",
							"title": "Group",
							"filter": false,
							"sort": true
						}
					]
				}
			}
		}
	}
}
